__pycache__/
*.py[cod]
.pytest_cache/
.venv/
build/
dist/
*.egg-info/

# Large or reproducible artifacts
references/pdfs/*.pdf
references/text/*.txt
references/repos/
data/raw/models/
research/validation/vendor/
experiments/runs/*
!experiments/runs/.gitkeep
!experiments/runs/simulation/
!experiments/runs/simulation/**
!experiments/runs/model_pilot_*_final/
!experiments/runs/model_pilot_*_final/**
!experiments/runs/interactive_*_final/
!experiments/runs/interactive_*_final/**
!experiments/runs/interactive_qwen3_4b_devtuning_rangefix_20260904/
!experiments/runs/interactive_qwen3_4b_devtuning_rangefix_20260904/**
artifacts/*
!artifacts/.gitkeep
!artifacts/README.md
!artifacts/build_bundle.sh
!artifacts/MANIFEST.sha256
!artifacts/build_predicate_rts_bundle.sh
!artifacts/PREDICATE_RTS_MANIFEST.sha256
!artifacts/verify_predicate_rts.sh
!artifacts/predicate_rts_reproducibility_bundle.tar.gz

# Large deterministic selection traces belong in release bundles, not Git.
revisions/*/results/**/evaluations.jsonl

# This near-100 MB development oracle is retained in the current release bundle.
revisions/19_shadow_release_testing/results/exposed_science_oracles/trajectories.jsonl

# Paper build products are regenerated by paper/build.sh
paper/en/*.aux
paper/en/*.bbl
paper/en/*.blg
paper/en/*.fdb_latexmk
paper/en/*.fls
paper/en/*.log
paper/en/*.out
paper/en/*.xdv
paper/zh/*.aux
paper/zh/*.bbl
paper/zh/*.blg
paper/zh/*.fdb_latexmk
paper/zh/*.fls
paper/zh/*.log
paper/zh/*.out
paper/zh/*.xdv

paper/predicate_rts/*/*.aux
paper/predicate_rts/*/*.bbl
paper/predicate_rts/*/*.blg
paper/predicate_rts/*/*.fdb_latexmk
paper/predicate_rts/*/*.fls
paper/predicate_rts/*/*.log
paper/predicate_rts/*/*.out
paper/predicate_rts/*/*.xdv
